    <!--Start Dashboard Content-->

    <div class="card-content">
        <div class="row row-group m-0">
            <div class="col-12 col-lg-6 col-xl-12 border-light">
                <div class="card-body">
                    <h4 class="text-white mb-3"><%=  nama_mata_kuliah %></h4>
                    <h6 class="mb-0 text-white small-font">Nama Dosen</h6>
                    <p><%= nama_dosen %></p>
                    <h6 class="mb-0 text-white small-font">Jadwal Kuliah:</h6>
                    <p><%= jadwal %>, <%= start_absen %> - <%= end_absen %></p>
                    <h6 class="mb-0 text-white small-font">Kelas</h6>
                    <p><%= ruangan %></p>
                    <hr>
                    <% if (!absensiAktif || absensiAktif.length === 0 || absensiAktif[0].status === 'tutup') { %>
                        <form action="/dosen/<%= id_dosen %>/bukaPresensi/<%= id_jadwal %>" method="post">
                            <button type="submit" id="bukaButton" class="btn btn-info">Buka Absensi</button>
                        </form>
                    <% } else if (absensiAktif[0].status === 'buka') { %>
                        <form action="/dosen/<%= id_dosen %>/tutupPresensi/<%= id_jadwal %>" method="post">
                            <button type="submit" id="tutupButton" class="btn btn-danger">Tutup Absensi</button>
                        </form>
                    <% } %>
                <hr>
                </div>
            </div>
        </div>
    </div>
    
    
    <div class="table-responsive mt-3">
        <h5 class="ctt">Catatan Presensi</h5>
        <table class="table table-hover">
            <thead>
                <tr>
                    <th scope="col">Tanggal</th>
                    <th scope="col">Jumlah Presensi</th>
                </tr>
            </thead>
            <tbody id="historiPresensi">
                <% if (histori.length > 0) { %>
                    <% histori.forEach((item) => { %>
                            <tr>
                                <td class="tanggal-history"><%= item.history_pembuatan.toString().slice(0, 25) %></td>
                                <td>
                                    <%= jumlahPresensi %>
                                </td>
                            </tr>
                    <% }); %>
                <% } else { %>
                    <tr class="no-history">
                        <td colspan="3" style="text-align: center;">Belum ada histori presensi.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
    
      </div>  
        
      <!-- DataTales Example -->
      <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Daftar Mahasiswa</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>NRP</th>
                            <th>Nama</th>
                            <th>Jenis Kelamin</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (dataMahasiswa.length > 0) { %>
                            <% dataMahasiswa.forEach((item) => { %>
                                <tr>
                                    <td><%= item.nrp %></td>
                                    <td><%= item.nama_mahasiswa %></td>
                                    <td><%= item.jenis_kelamin %></td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr class="no-history">
                                <td colspan="3" style="text-align: center;">Belum ada mahasiswa yang ditambahkan.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
