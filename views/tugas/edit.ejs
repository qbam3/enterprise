            <form action="/dosen/<%= id_dosen %>/tugas/<%= id_jadwal %>/update/<%= id_tugas %>" enctype="multipart/form-data" method="post">
                <div class="mb-3">
                  <label for="exampleInputEmail1" class="form-label">Judul</label>
                  <input type="text" value="<%= dataTugas[0].judul_tugas %>" name="judul_tugas" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" required>
                </div>
                <div class="mb-3">
                    <label for="exampleFormControlTextarea1" class="form-label">Deskripsi</label>
                    <textarea class="form-control"  name="deskripsi_tugas" id="exampleFormControlTextarea1" rows="3" ><%= dataTugas[0].deskripsi_tugas %></textarea>
                </div>
                <div class="mb-3">
                    <label for="exampleInputEmail1" class="form-label">Deadline</label>
                    <input type="datetime-local" value="<%= dataTugas[0].deadline %>" name="deadline" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" required>
                </div>
                <div class="mb-3">
                  <label for="exampleInputPassword1" class="form-label">File Tugas</label>
                  <% if (dataTugas[0].file_tugas) { %>
                    <% 
                        const fileName = dataTugas[0].file_tugas;
                        const fileExtension = fileName.split('.').pop().toLowerCase();
                    %>
                    <div class="file-preview">
                        <a href="/path/to/uploaded/files/<%= fileName %>" target="_blank">
                            <img style="width: 20px;">
                            <%= fileName %>
                        </a>
                    </div>
                <% } %>
            </div>
            
                <div class="mt-3">
                    <input type="file" name="file_tugas" class="form-control" id="file_tugas" required>
                </div>
                <input type="hidden" name="old_file_tugas" value="<%= dataTugas[0].file_tugas %>">
                <br>
                </div>
                <button type="submit" class="btn btn-primary">Submit</button>
            </form>
            <!--End Dashboard Content-->
	  
            <!--start overlay-->
            <div class="overlay toggle-menu"></div>
            <!--end overlay-->
		
        </div>
