        </nav>
    </header>
    <!--End topbar header-->

    <div class="clearfix"></div>
<div class="content-wrapper">
    <div class="container-fluid">

        <!--Start Dashboard Content-->
        <a href="/admin/<%= id_users %>/jadwal/create" class="btn btn-success mb-3">Add Data <i class="fas fa-plus"></i></a>
        <div class="card mt-3 mb-3">
            <div class="card-content">
                <div class="row row-group m-0">
                    <% dataJadwal.forEach(function(data) { %>
                        <% if (data.nama_dosen && data.nama_mata_kuliah && data.jadwal_kuliah && data.start_absensi && data.end_absensi) { %>
                            <div class="col-12 col-lg-6 col-xl-12 border-light">
                                <div class="card-body">
                                    <h5 class="text-white mb-0">
                                        <%= data.nama_mata_kuliah %>
                                    </h5>
                                    <p class="text-white mb-0">
                                        Dosen: <%= data.nama_dosen %><br>
                                        Jadwal Kuliah: <%= data.jadwal_kuliah %><br>
                                        Mulai Absensi: <%= data.start_absensi %> - Selesai Absensi: <%= data.end_absensi %>
                                    </p>
                                    <br>
                                    <td><a href="/admin/<%= id_users %>/jadwal/<%= data.id_jadwal %>/edit" class="btn btn-warning">Edit</a></td>
                                    <td><a href="/admin/<%= id_users %>/jadwal/<%= data.id_jadwal %>/delete" class="btn btn-danger">Delete</a></td>
                                </div>
                            </div>
                        <% } %>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</div>

    
            <!--End Dashboard Content-->
	  
            <!--start overlay-->
            <div class="overlay toggle-menu"></div>
            <!--end overlay-->
		
        </div>
        <!-- End container-fluid-->
    </div><!--End content-wrapper-->
   <!--Start Back To Top Button-->
    <a href="javaScript:void();" class="back-to-top"><i class="fa fa-angle-double-up"></i> </a>
    <!--End Back To Top Button-->
	
<%- include('../partials/__foot') %>