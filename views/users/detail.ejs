    <!--Start Dashboard Content-->

      <div class="card mt-3">
          <div class="card-content">
              <div class="row row-group m-0">
                  <div class="col-12 col-lg-6 col-xl-12 border-light">
                    <div class="card-body">
                        <h4 class="text-white mb-3"><%=  nama_mata_kuliah %></h4>
                        <h6 class="mb-0 text-white small-font">Nama Dosen</h6>
                        <p><%= nama_dosen %></p>
                        <h6 class="mb-0 text-white small-font">Jadwal Kuliah:</h6>
                        <p><%= jadwal %>, <%= start_absen %> - <%= end_absen %></p>
                        <h6 class="mb-0 text-white small-font">Kelas</h6>
                        <p><%= ruangan %></p>
                        <% if (typeof isAbsensiOpen === 'undefined' || isAbsensiOpen.length === 0 || isAbsensiDone) {%>
                        <button id="presensiButton" type="button" class="btn btn-primary" disabled>PRESENSI</button>
                       <% } else { %>
                        <form id="presensiForm" action="/mahasiswa/<%= id_mahasiswa %>/matakuliah/<%= id_jadwal %>/absen" method="POST">
                            <button id="presensiButton" type="submit" class="btn btn-primary">PRESENSI</button>
                       </form>
                        <% } %>
                    </div>
                  </div>
              </div>
          </div>
          <div class="table-responsive mt-3"></div>
            <table class="table table-hover"><h5 class="ctt">Catatan Presensi</h5>
              <thead>
                <tr>
                  <th scope="col">Tanggal</th>
                </tr>
              </thead>
              <tbody>
                <% if (dataDetailAbsen.length > 0) { %>
                    <% dataDetailAbsen.forEach((item) => { %>
                        <tr>
                            <td><%= item.tanggal_absensi.toString().slice(0, 15) %> <%= item.waktu_absensi%></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr class="no-history">
                        <td colspan="3" style="text-align: center;">Belum ada mahasiswa yang ditambahkan.</td>
                    </tr>
                <% } %>
              </tbody>
            </table>
      </div>  
        
      <!-- DataTales Example -->
      <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Daftar Mahasiswa</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>NRP</th>
                            <th>Nama</th>
                            <th>Jenis Kelamin</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (dataMahasiswa.length > 0) { %>
                            <% dataMahasiswa.forEach((item) => { %>
                                <tr>
                                    <td><%= item.nrp %></td>
                                    <td><%= item.nama_mahasiswa %></td>
                                    <td><%= item.jenis_kelamin %></td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr class="no-history">
                                <td colspan="3" style="text-align: center;">Belum ada mahasiswa yang ditambahkan.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
