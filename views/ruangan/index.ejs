    <script>
        function handleEdit(userId, role) {
            if (role === '3') {
                window.location.href = `/editMahasiswa/${userId}`; // Ganti dengan rute yang sesuai untuk mahasiswa
            } else if (role === '2') {
                window.location.href = `/editDosen/${userId}`; // Ganti dengan rute yang sesuai untuk dosen
            }
        }
    

function handleDelete(userId, role) {
    if (confirm('Apakah Anda yakin ingin menghapus pengguna ini?')) {
        const url = role === '3' ? `/admin/deleteMahasiswa/${userId}` : `/admin/deleteDosen/${userId}`;
        
        fetch(url, {
            method: 'POST'
        })
        .then(response => {
            if (response.ok) {
                // Jika penghapusan berhasil, reload halaman
                window.location.reload();
            } else {
                alert('Terjadi kesalahan saat menghapus pengguna');
            }
        })
        .catch(error => console.error('Error:', error));
    }
}
    </script>
